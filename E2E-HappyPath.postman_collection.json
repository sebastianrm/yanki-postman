					{"key": "X-Idempotency-Key", "value": "e2e-transfer-001", "type": "text"}
				],
				"body": {"mode": "raw", "raw": "{\n    \"sourceAccountId\": \"{{account_id_savings}}\",\n    \"destinationAccountId\": \"{{account_id_current}}\",\n    \"amount\": 500.0,\n    \"description\": \"Transferencia intra-cliente E2E\"\n}"},
				"url": {"raw": "{{base_url}}/api/transfers", "host": ["{{base_url}}"], "path": ["api", "transfers"]},
				"description": "Transfiere S/500 de SAVINGS a CURRENT (intra-cliente). Saldo SAVINGS esperado: S/3,500. Saldo CURRENT esperado: S/1,000.\n\n**Endpoint:** POST /api/transfers\n**Header:** X-Idempotency-Key para garantizar idempotencia\n**Respuesta esperada:** Status 201 o 202"
			},
			"event": [
				{"listen": "test", "script": {"exec": ["pm.test(\"Status code is 201 or 202\", function () { pm.expect(pm.response.code).to.be.oneOf([201, 202]); });"], "type": "text/javascript"}}
			],
			"response": []
		},
