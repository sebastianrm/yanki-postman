				],
				"body": {"mode": "raw", "raw": "{\n    \"documentType\": \"DNI\",\n    \"documentNumber\": \"70200001\",\n    \"firstName\": \"Carlos\",\n    \"lastName\": \"TestStandard\",\n    \"email\": \"carlos.standard@test.com\",\n    \"phone\": \"999111222\",\n    \"address\": \"Av. Standard 100\",\n    \"birthDate\": \"1985-05-15\",\n    \"type\": \"PERSONAL\",\n    \"profile\": \"STANDARD\"\n}"},
				"url": {"raw": "{{base_url}}/api/customers", "host": ["{{base_url}}"], "path": ["api", "customers"]},
				"description": "Crea el primer cliente: PERSONAL STANDARD. Este cliente será el protagonista del flujo E2E: abrirá cuentas, emitirá tarjetas y realizará transferencias.\n\n**Endpoint:** POST /api/customers\n**Respuesta esperada:** Status 201 con customerId"
			},
			"event": [
				{"listen": "test", "script": {"exec": ["pm.test(\"Status code is 201\", function () { pm.response.to.have.status(201); });", "var jsonData = pm.response.json(); pm.collectionVariables.set(\"customer_id_standard\", jsonData.customerId);"], "type": "text/javascript"}}
			],
			"response": []
		},
